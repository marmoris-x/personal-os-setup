{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_GIT_BASH_PATH": "C:\\Program Files\\Git\\bin\\bash.exe",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "180000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_DISABLE_MOUSE_CLICKS": "1",
    "DISABLE_COST_WARNINGS": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "GIT_OPTIONAL_LOCKS": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Edit",
      "PowerShell(git add *)",
      "Bash(git add *)",
      "PowerShell(git commit *)",
      "Bash(git commit *)",
      "PowerShell(npm run *)",
      "Bash(npm run *)",
      "WebFetch",
      "WebSearch",
      "PowerShell(gh search *)",
      "Bash(gh search *)",
      "PowerShell(gh repo view *)",
      "Bash(gh repo view *)",
      "PowerShell(gh repo clone *)",
      "Bash(gh repo clone *)",
      "PowerShell(git clone *)",
      "Bash(git clone *)",
      "mcp__exa__*",
      "mcp__exa-key__*",
      "mcp__you-free__*",
      "mcp__you__*",
      "mcp__tavily__*",
      "mcp__firecrawl__*",
      "mcp__parallel__*"
    ],
    "deny": [
      "WebFetch",
      "mcp__exa__web_fetch_exa",
      "mcp__exa-key__web_fetch_exa",
      "mcp__parallel__web_fetch",
      "mcp__firecrawl__firecrawl_scrape",
      "mcp__firecrawl__firecrawl_crawl",
      "mcp__firecrawl__firecrawl_extract",
      "mcp__tavily__tavily_extract",
      "mcp__tavily__tavily_crawl",
      "mcp__you__you-contents",
      "mcp__you-free__you-contents",
      "Read(//c/**/.env)",
      "Read(//c/**/*.pem)",
      "Read(/{{DEV_BASH}}/Projects/**/Server Keys/**)",
      "Read(//c/Users/*/.claude/profiles/**)",
      "Edit(//c/Users/*/.claude/profiles/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push --force-with-lease*)",
      "Bash(git commit *--no-veri*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git push *--no-veri*)",
      "PowerShell(git commit *--no-veri*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n*)",
      "PowerShell(git push *--no-veri*)",
      "Bash(git -C * commit *--no-veri*)",
      "Bash(git -C * commit -n*)",
      "Bash(git -C * commit * -n*)",
      "Bash(git -C * push *--no-veri*)",
      "PowerShell(git -C * commit *--no-veri*)",
      "PowerShell(git -C * commit -n*)",
      "PowerShell(git -C * commit * -n*)",
      "PowerShell(git -C * push *--no-veri*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "if (-not (Test-Path -LiteralPath '{{HOME_FWD}}/.claude/hooks/block-dangerous.ps1')) { exit 1 }; & '{{HOME_FWD}}/.claude/hooks/block-dangerous.ps1'; exit $LASTEXITCODE"
            ],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "if (-not (Test-Path -LiteralPath '{{HOME_FWD}}/.claude/hooks/downloads-guard.ps1')) { exit 1 }; & '{{HOME_FWD}}/.claude/hooks/downloads-guard.ps1'; exit $LASTEXITCODE"
            ],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "if (-not (Test-Path -LiteralPath '{{HOME_FWD}}/.claude/hooks/archive-guard.ps1')) { exit 1 }; & '{{HOME_FWD}}/.claude/hooks/archive-guard.ps1'; exit $LASTEXITCODE"
            ],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash|PowerShell|Monitor|Artifact|LSP|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "if (-not (Test-Path -LiteralPath '{{HOME_FWD}}/.claude/hooks/onedrive-guard.ps1')) { exit 1 }; & '{{HOME_FWD}}/.claude/hooks/onedrive-guard.ps1'; exit $LASTEXITCODE"
            ],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash|PowerShell|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "if (-not (Test-Path -LiteralPath '{{HOME_FWD}}/.claude/hooks/trifecta-guard.ps1')) { exit 1 }; & '{{HOME_FWD}}/.claude/hooks/trifecta-guard.ps1'; exit $LASTEXITCODE"
            ],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "if (-not (Test-Path -LiteralPath '{{HOME_FWD}}/.claude/hooks/no-license-files.ps1')) { exit 1 }; & '{{HOME_FWD}}/.claude/hooks/no-license-files.ps1'; exit $LASTEXITCODE"
            ],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "WebFetch|mcp__.*__(?:.*(?:fetch|scrape|extract|crawl|contents|read[_-]?url).*)|mcp__.*__(?:navigate|browser_batch|.*(?:generate|create|make|text[_-]?to|txt2)[_-]?image.*|.*image[_-]?(?:generat|creat|gen).*)|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "if (-not (Test-Path -LiteralPath '{{HOME_FWD}}/.claude/hooks/fetch-guard.ps1')) { exit 1 }; & '{{HOME_FWD}}/.claude/hooks/fetch-guard.ps1'; exit $LASTEXITCODE"
            ],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{HOME_FWD}}/.claude/hooks/skill-usage.ps1"
            ],
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{HOME_FWD}}/.claude/hooks/session-check.ps1"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{HOME_FWD}}/.claude/hooks/stop-notify.ps1"
            ],
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-WindowStyle",
              "Hidden",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{HOME_FWD}}/.claude/hooks/notification-idle.ps1"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "permission_prompt|agent_needs_input|agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-WindowStyle",
              "Hidden",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{HOME_FWD}}/.claude/hooks/notification-events.ps1"
            ],
            "async": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "enableWorkflows": true,
  "workflowSizeGuideline": "medium",
  "defaultShell": "powershell",
  "bashOutputMaxChars": 15000,
  "statusLine": {
    "type": "command",
    "command": "{{PWSH_PATH}} -NoProfile -ExecutionPolicy Bypass -File {{HOME_FWD}}/.claude/statusline.ps1"
  },
  "skillOverrides": {
    "dataviz": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "update-config": "user-invocable-only",
    "loop": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "simplify": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "codeguard-security@project-codeguard": false,
    "context7@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "project-codeguard": {
      "source": {
        "source": "github",
        "repo": "cosai-oasis/project-codeguard"
      }
    }
  },
  "language": "german",
  "feedbackSurveyRate": 0,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "deepseek-flash": {
      "effortLevel": "xhigh"
    }
  },
  "autoCompactWindow": 400000,
  "fastModePerSessionOptIn": true,
  "promptSuggestionEnabled": false,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "claudeMdExcludes": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**"
  ]
}
