{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "fallbackModel": [
    "opus"
  ],
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_AUTH_TOKEN": "<DEEPSEEK_API_KEY>",
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-pro[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-flash[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-flash",
    "CLAUDE_CODE_SUBAGENT_MODEL": "deepseek-flash[1m]",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES": "effort,max_effort,thinking,interleaved_thinking",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES": "effort,max_effort,thinking,interleaved_thinking",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{HOME_FWD}}/.claude/hooks/deepseek-orientation.ps1",
              "-Part",
              "1"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{HOME_FWD}}/.claude/hooks/deepseek-orientation.ps1",
              "-Part",
              "2"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{HOME_FWD}}/.claude/hooks/deepseek-orientation.ps1",
              "-Part",
              "3"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{HOME_FWD}}/.claude/hooks/deepseek-orientation.ps1",
              "-Part",
              "1"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{HOME_FWD}}/.claude/hooks/deepseek-orientation.ps1",
              "-Part",
              "2"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{PWSH_HOST}}",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{HOME_FWD}}/.claude/hooks/deepseek-orientation.ps1",
              "-Part",
              "3"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}