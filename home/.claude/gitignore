# claude-config: whitelist. Everything is ignored except what is listed below.
*
!.gitignore
!.gitleaksignore
!.kopiaignore
!.gitattributes
!README.md
!CLAUDE.md
!settings.json
!statusline.ps1
!keybindings.json
!hooks/
!hooks/*.ps1
!agents/
!agents/*.md
!rules/
!rules/*.md
!skills/
!skills/**
!profiles-template/
!profiles-template/*.json
!orientation/
!orientation/*.md
!docs/
!docs/**
!setup/
!setup/**
!life-os/
!life-os/**
# never, even if matched above
profiles/
**/*.key
**/.env
**/.credentials.json
**/settings.local.json
**/privacy-blocklist.txt
**/__pycache__/
**/*.pyc
# skills synced from claude.ai (Anthropic's own, not part of this setup)
skills/synced/

# official video workflow templates: fetched by the /video script from the pinned commit and
# kept out of every repository (a decimal number reads as a 12-digit id to the privacy scan,
# ADR 0022)
skills/video/video_ltx2_3_t2v.json
skills/video/video_ltx2_3_i2v.json